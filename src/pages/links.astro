---
/**
 * Page "one link" style Linktree : https://bricefotzo.dev/links
 *
 * Les liens et sections sont dans src/data/links.json, affichés dans l'ordre.
 * Mode édition : bouton "Modifier" en bas de page (ou https://bricefotzo.dev/links?edit)
 *   ajouter un lien ou une section, modifier, supprimer, réordonner, mettre en avant,
 *   puis "Publier" commite links.json sur GitHub (token gardé dans ton navigateur).
 */
import data from '../data/links.json';
import { icons, iconSvg } from '../data/icons';
import LinkCard from '../components/LinkCard.astro';

type Section = { id: string; type: 'section'; title: string };
type Link = {
	id: string;
	type?: 'link';
	title: string;
	subtitle?: string;
	href: string;
	icon: string;
	featured?: boolean;
	placeholder?: boolean;
};

const items = data.items as (Section | Link)[];
const socials = [
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/bricefotzo/', icon: 'linkedin' },
	{ label: 'GitHub', href: 'https://github.com/bricefotzo', icon: 'github' },
	{ label: 'Medium', href: 'https://bricefotzo.medium.com/', icon: 'medium' },
];
const json = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Brice Fotzo · Liens</title>
		<meta name="description" content="Tous les liens de Brice Fotzo : talk DevFest, projets, articles et réseaux." />
		<meta property="og:title" content="Brice Fotzo · Liens" />
		<meta property="og:description" content="Talk DevFest gcloud run compose up, GCP Release Notes, LinkedIn et plus." />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body>
		<main class="wrap">
			<header class="profile">
				<div class="avatar" aria-hidden="true">BF</div>
				<h1>Brice Fotzo</h1>
				<p class="role">Data &amp; Cloud Native Engineer</p>
				<p class="bio">Data, Containers, Cloud Native &amp; Backend</p>
				<nav class="socials" aria-label="Réseaux">
					{socials.map((s) => (
						<a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
							<svg viewBox="0 0 24 24" fill="currentColor" set:html={iconSvg(s.icon)} />
						</a>
					))}
				</nav>
			</header>

			<!-- Vue publique (rendue au build, sans JavaScript) -->
			<div id="view" class="stack">
				{items.map((item) =>
					item.type === 'section' ? (
						<p class="section-label">{item.title}</p>
					) : (
						<LinkCard {...(item as Link)} />
					)
				)}
			</div>

			<!-- Mode édition, construit par le script ci-dessous -->
			<div id="editor" hidden></div>

			<footer class="foot">
				<a href="/">bricefotzo.dev</a>
				<a href="?edit" class="edit-link" id="edit-link" aria-label="Modifier les liens">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
					Modifier
				</a>
			</footer>
		</main>

		<dialog id="link-dialog" class="dlg">
			<form method="dialog" id="link-form">
				<h2 id="link-dialog-title">Modifier le lien</h2>
				<label>Titre<input name="title" required maxlength="80" /></label>
				<label>Sous-titre<input name="subtitle" maxlength="160" /></label>
				<label>URL<input name="href" placeholder="https://… (vide = placeholder)" inputmode="url" /></label>
				<p class="field-error" id="href-error" hidden>L'URL doit commencer par https://, http://, / ou mailto:</p>
				<label>Icône
					<span class="icon-pick">
						<span class="icon" id="icon-preview"></span>
						<select name="icon"></select>
					</span>
				</label>
				<label class="check"><input type="checkbox" name="featured" /> Mettre en avant (carte colorée)</label>
				<label class="check"><input type="checkbox" name="placeholder" /> Placeholder (grisé, badge « Bientôt »)</label>
				<div class="dlg-actions">
					<button type="button" class="btn" data-close>Annuler</button>
					<button type="submit" class="btn btn-primary" value="save">Enregistrer</button>
				</div>
			</form>
		</dialog>

		<dialog id="settings-dialog" class="dlg">
			<form method="dialog" id="settings-form">
				<h2>Publication GitHub</h2>
				<p class="hint">
					Crée un <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">token fine-grained</a>
					limité au repo, avec la permission <strong>Contents : Read and write</strong>.
					Il est gardé uniquement dans ce navigateur.
				</p>
				<label>Token GitHub<input name="token" type="password" autocomplete="off" placeholder="github_pat_…" /></label>
				<label>Repo<input name="repo" required placeholder="owner/repo" /></label>
				<label>Branche<input name="branch" required /></label>
				<div class="dlg-actions">
					<button type="button" class="btn btn-danger-ghost" id="forget-token">Oublier le token</button>
					<span class="spacer"></span>
					<button type="button" class="btn" data-close>Annuler</button>
					<button type="submit" class="btn btn-primary" value="save">Enregistrer</button>
				</div>
			</form>
		</dialog>

		<div id="toast" role="status" aria-live="polite"></div>

		<script type="application/json" id="links-data" set:html={json(data)} />
		<script type="application/json" id="icons-data" set:html={json(icons)} />

		<script>
			type Link = {
				id: string;
				type?: 'link';
				title: string;
				subtitle?: string;
				href: string;
				icon: string;
				featured?: boolean;
				placeholder?: boolean;
			};
			type Section = { id: string; type: 'section'; title: string };
			type Item = Link | Section;
			type Data = { items: Item[] };
			type Settings = { repo: string; branch: string };

			const FILE_PATH = 'src/data/links.json';
			const KEYS = { draft: 'links-editor:draft', token: 'links-editor:token', settings: 'links-editor:settings' };
			const DEFAULT_SETTINGS: Settings = { repo: 'bricefotzo/bf-blog', branch: 'main' };

			const store = {
				get(key: string) {
					try { return localStorage.getItem(key); } catch { return null; }
				},
				set(key: string, value: string) {
					try { localStorage.setItem(key, value); } catch { /* stockage indisponible */ }
				},
				del(key: string) {
					try { localStorage.removeItem(key); } catch { /* idem */ }
				},
			};

			if (new URLSearchParams(location.search).has('edit')) initEditor();

			function initEditor() {
				const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;
				const icons: Record<string, { label: string; svg: string }> = JSON.parse($('#icons-data').textContent!);
				let published: Data = JSON.parse($('#links-data').textContent!);
				let state: Data = loadDraft() ?? clone(published);
				let settings: Settings = { ...DEFAULT_SETTINGS, ...safeParse(store.get(KEYS.settings)) };
				let editingId: string | null = null;

				const view = $('#view');
				const editor = $('#editor');
				const linkDialog = $<HTMLDialogElement>('#link-dialog');
				const linkForm = $<HTMLFormElement>('#link-form');
				const settingsDialog = $<HTMLDialogElement>('#settings-dialog');
				const settingsForm = $<HTMLFormElement>('#settings-form');
				const iconSelect = linkForm.elements.namedItem('icon') as HTMLSelectElement;

				document.body.classList.add('editing');
				view.hidden = true;
				editor.hidden = false;

				for (const [key, { label }] of Object.entries(icons)) iconSelect.add(new Option(label, key));
				iconSelect.addEventListener('change', () => ($('#icon-preview').innerHTML = svg(iconSelect.value)));

				render();

				/* ---------- rendu ---------- */

				function render() {
					editor.replaceChildren();

					const banner = el('div', 'edit-banner');
					banner.append(
						el('strong', '', 'Mode édition'),
						el('span', '', 'Les changements restent en brouillon dans ce navigateur jusqu\'à « Publier ».'),
					);

					const list = el('ol', 'stack edit-list');
					state.items.forEach((item, i) =>
						list.append(isSection(item) ? renderSection(item, i) : renderItem(item, i)),
					);

					const adds = el('div', 'add-row');
					adds.append(
						addButton('Ajouter un lien', () => openLinkDialog(null)),
						addButton('Ajouter une section', () => {
							const id = newId();
							state.items.push({ id, type: 'section', title: 'Nouvelle section' });
							persist();
							const input = editor.querySelector<HTMLInputElement>(`[data-section="${id}"]`);
							input?.focus();
							input?.select();
						}),
					);

					editor.append(banner, list, adds, renderToolbar());
				}

				function renderSection(section: Section, i: number) {
					const li = el('li', 'edit-section');
					const input = document.createElement('input');
					input.value = section.title;
					input.dataset.section = section.id;
					input.setAttribute('aria-label', 'Titre de la section');
					input.placeholder = 'Titre de la section';
					input.addEventListener('input', () => {
						section.title = input.value;
						persist(false);
					});
					const actions = el('span', 'actions');
					actions.append(
						iconButton('Monter', 'M12 19V5M5 12l7-7 7 7', () => move(i, -1), i === 0),
						iconButton('Descendre', 'M12 5v14M19 12l-7 7-7-7', () => move(i, 1), i === state.items.length - 1),
						iconButton('Supprimer la section', 'M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6', () => remove(section), false, false, true),
					);
					li.append(input, actions);
					return li;
				}

				function renderItem(link: Link, i: number) {
					const li = el('li', 'card edit-card');
					if (link.featured) li.classList.add('card-featured');
					if (link.placeholder || !link.href) li.classList.add('card-placeholder');

					const icon = el('span', 'icon');
					icon.innerHTML = svg(link.icon);
					const text = el('span', 'text');
					const title = el('span', 'title', link.title || '(sans titre)');
					if (link.featured) title.prepend(el('span', 'pill', 'En avant'));
					if (link.placeholder || !link.href) title.append(el('span', 'pill pill-muted', 'Bientôt'));
					text.append(title, el('span', 'subtitle', link.href || 'Pas encore d\'URL'));

					const actions = el('span', 'actions');
					actions.append(
						iconButton('Monter', 'M12 19V5M5 12l7-7 7 7', () => move(i, -1), i === 0),
						iconButton('Descendre', 'M12 5v14M19 12l-7 7-7-7', () => move(i, 1), i === state.items.length - 1),
						iconButton(link.featured ? 'Ne plus mettre en avant' : 'Mettre en avant',
							'M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z',
							() => update(link.id, { featured: !link.featured }), false, link.featured),
						iconButton('Modifier', 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z', () => openLinkDialog(link.id)),
						iconButton('Supprimer', 'M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6', () => remove(link), false, false, true),
					);

					li.append(icon, text, actions);
					return li;
				}

				function renderToolbar() {
					const bar = el('div', 'toolbar');
					const dirty = isDirty();
					const status = el('span', 'status', dirty ? 'Modifications non publiées' : 'À jour avec la version publiée');
					status.classList.toggle('status-dirty', dirty);

					const settingsBtn = button('Réglages', 'btn', () => openSettings());
					const resetBtn = button('Annuler les modifs', 'btn', () => {
						if (!confirm('Revenir à la version publiée ? Le brouillon sera perdu.')) return;
						state = clone(published);
						persist();
						toast('Brouillon annulé');
					});
					resetBtn.disabled = !dirty;
					const publishBtn = button('Publier', 'btn btn-primary', () => publish(publishBtn));
					publishBtn.disabled = !dirty;
					const exitBtn = button('Quitter', 'btn btn-ghost', () => (location.href = location.pathname));

					const group = el('span', 'toolbar-actions');
					group.append(settingsBtn, resetBtn, publishBtn, exitBtn);
					bar.append(status, group);
					return bar;
				}

				/* ---------- actions ---------- */

				function move(i: number, delta: number) {
					const j = i + delta;
					if (j < 0 || j >= state.items.length) return;
					[state.items[i], state.items[j]] = [state.items[j], state.items[i]];
					persist();
				}

				function update(id: string, patch: Partial<Link>) {
					state.items = state.items.map((item) => (item.id === id && !isSection(item) ? clean({ ...item, ...patch }) : item));
					persist();
				}

				function remove(item: Item) {
					const what = isSection(item) ? `la section « ${item.title} »` : `« ${item.title} »`;
					if (!confirm(`Supprimer ${what} ?`)) return;
					const index = state.items.findIndex((x) => x.id === item.id);
					state.items.splice(index, 1);
					persist();
					toast(`${what.charAt(0).toUpperCase()}${what.slice(1)} supprimé${isSection(item) ? 'e' : ''}`, 'Annuler', () => {
						state.items.splice(index, 0, item);
						persist();
					});
				}

				function openLinkDialog(id: string | null) {
					editingId = id;
					const link = id ? (state.items.find((x) => x.id === id) as Link) : { id: '', title: '', subtitle: '', href: '', icon: 'link' };
					$('#link-dialog-title').textContent = id ? 'Modifier le lien' : 'Ajouter un lien';
					field('title').value = link.title;
					field('subtitle').value = link.subtitle ?? '';
					field('href').value = link.href;
					iconSelect.value = icons[link.icon] ? link.icon : 'link';
					$('#icon-preview').innerHTML = svg(iconSelect.value);
					field('featured').checked = !!link.featured;
					field('placeholder').checked = !!link.placeholder;
					$('#href-error').hidden = true;
					linkDialog.showModal();
					field('title').focus();
				}

				linkForm.addEventListener('submit', (e) => {
					const href = field('href').value.trim();
					const placeholder = field('placeholder').checked;
					if (href && !/^(https?:\/\/|\/|mailto:)/i.test(href)) {
						e.preventDefault();
						$('#href-error').hidden = false;
						field('href').focus();
						return;
					}
					const values: Partial<Link> = {
						title: field('title').value.trim(),
						subtitle: field('subtitle').value.trim(),
						href,
						icon: iconSelect.value,
						featured: field('featured').checked,
						// Une URL vide reste forcément un placeholder.
						placeholder: placeholder || !href,
					};
					if (editingId) {
						update(editingId, values);
						toast('Lien modifié');
					} else {
						state.items.push(clean({ id: newId(), ...values } as Link));
						persist();
						toast('Lien ajouté');
					}
				});

				function openSettings() {
					sfield('token').value = store.get(KEYS.token) ?? '';
					sfield('repo').value = settings.repo;
					sfield('branch').value = settings.branch;
					settingsDialog.showModal();
				}

				settingsForm.addEventListener('submit', () => {
					const token = sfield('token').value.trim();
					if (token) store.set(KEYS.token, token);
					settings = { repo: sfield('repo').value.trim(), branch: sfield('branch').value.trim() };
					store.set(KEYS.settings, JSON.stringify(settings));
					toast('Réglages enregistrés');
				});

				$('#forget-token').addEventListener('click', () => {
					store.del(KEYS.token);
					sfield('token').value = '';
					toast('Token supprimé de ce navigateur');
				});

				for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-close]')) {
					btn.addEventListener('click', () => btn.closest('dialog')!.close());
				}

				async function publish(btn: HTMLButtonElement) {
					const token = store.get(KEYS.token);
					if (!token) {
						toast('Ajoute d\'abord ton token GitHub');
						openSettings();
						return;
					}
					btn.disabled = true;
					btn.textContent = 'Publication…';
					try {
						const api = `https://api.github.com/repos/${settings.repo}/contents/${FILE_PATH}`;
						const headers = {
							Authorization: `Bearer ${token}`,
							Accept: 'application/vnd.github+json',
							'X-GitHub-Api-Version': '2022-11-28',
						};
						const current = await fetch(`${api}?ref=${encodeURIComponent(settings.branch)}`, { headers, cache: 'no-store' });
						if (!current.ok && current.status !== 404) throw await apiError(current);
						const sha = current.ok ? (await current.json()).sha : undefined;

						const res = await fetch(api, {
							method: 'PUT',
							headers,
							body: JSON.stringify({
								message: 'Update links page (/links)',
								content: toBase64(JSON.stringify(state, null, 2) + '\n'),
								branch: settings.branch,
								sha,
							}),
						});
						if (!res.ok) throw await apiError(res);

						published = clone(state);
						store.del(KEYS.draft);
						render();
						toast('Publié sur GitHub. Le site se met à jour au prochain déploiement.');
					} catch (err) {
						btn.disabled = false;
						btn.textContent = 'Publier';
						toast(`Échec de la publication : ${(err as Error).message}`);
					}
				}

				/* ---------- utilitaires ---------- */

				function persist(rerender = true) {
					if (isDirty()) store.set(KEYS.draft, JSON.stringify(state));
					else store.del(KEYS.draft);
					if (rerender) render();
					else editor.querySelector('.toolbar')?.replaceWith(renderToolbar());
				}
				function loadDraft(): Data | null {
					const d = safeParse(store.get(KEYS.draft));
					return d && Array.isArray(d.items) ? d : null;
				}
				function isDirty() {
					return JSON.stringify(state) !== JSON.stringify(published);
				}
				function field(name: string) {
					return linkForm.elements.namedItem(name) as HTMLInputElement;
				}
				function sfield(name: string) {
					return settingsForm.elements.namedItem(name) as HTMLInputElement;
				}
				function svg(name: string) {
					const body = (icons[name] ?? icons.link).svg;
					return `<svg viewBox="0 0 24 24" fill="currentColor">${body}</svg>`;
				}
				function addButton(label: string, onClick: () => void) {
					const b = el('button', 'card add-card');
					b.type = 'button';
					b.innerHTML = '<span class="icon"><svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M12 5v14M5 12h14"/></svg></span>';
					b.append(el('span', 'title', label));
					b.addEventListener('click', onClick);
					return b;
				}
				function iconButton(label: string, path: string, onClick: () => void, disabled = false, active = false, danger = false) {
					const b = document.createElement('button');
					b.type = 'button';
					b.className = 'icon-btn' + (active ? ' is-active' : '') + (danger ? ' is-danger' : '');
					b.title = label;
					b.setAttribute('aria-label', label);
					b.disabled = disabled;
					b.innerHTML = `<svg viewBox="0 0 24 24"><path fill="${active ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="${path}"/></svg>`;
					b.addEventListener('click', onClick);
					return b;
				}
				function button(label: string, cls: string, onClick: () => void) {
					const b = el('button', cls, label);
					b.type = 'button';
					b.addEventListener('click', onClick);
					return b;
				}

				let toastTimer: number | undefined;
				function toast(message: string, actionLabel?: string, action?: () => void) {
					const t = $('#toast');
					t.replaceChildren(el('span', '', message));
					if (actionLabel && action) {
						t.append(button(actionLabel, 'toast-action', () => {
							action();
							t.classList.remove('show');
						}));
					}
					t.classList.add('show');
					clearTimeout(toastTimer);
					toastTimer = window.setTimeout(() => t.classList.remove('show'), 5000);
				}
			}

			function isSection(item: Item): item is Section {
				return (item as Section).type === 'section';
			}
			function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) {
				const node = document.createElement(tag);
				if (cls) node.className = cls;
				if (text !== undefined) node.textContent = text;
				return node;
			}
			function clone<T>(v: T): T {
				return JSON.parse(JSON.stringify(v));
			}
			function safeParse(raw: string | null) {
				try { return raw ? JSON.parse(raw) : null; } catch { return null; }
			}
			/** Retire les champs vides / false pour garder un links.json propre. */
			function clean(link: Link): Link {
				const href = link.href ?? '';
				return {
					id: link.id,
					title: link.title,
					...(link.subtitle ? { subtitle: link.subtitle } : {}),
					href,
					icon: link.icon,
					...(link.featured ? { featured: true } : {}),
					...(link.placeholder || !href ? { placeholder: true } : {}),
				};
			}
			function newId() {
				return Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
			}
			function toBase64(text: string) {
				let bin = '';
				for (const byte of new TextEncoder().encode(text)) bin += String.fromCharCode(byte);
				return btoa(bin);
			}
			async function apiError(res: Response) {
				let msg = '';
				try { msg = (await res.json()).message; } catch { /* corps vide */ }
				if (res.status === 401) msg = 'token invalide ou expiré';
				if (res.status === 403 || res.status === 404) msg = `${msg || 'accès refusé'} (vérifie le repo, la branche et la permission Contents du token)`;
				return new Error(`${res.status} ${msg}`.trim());
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f6f7fb;
		--bg-glow: rgba(66, 133, 244, 0.14);
		--surface: #ffffff;
		--surface-hover: #f0f4ff;
		--border: #e3e6ee;
		--text: #14161c;
		--muted: #5c6270;
		--accent: #1a73e8;
		--accent-soft: rgba(26, 115, 232, 0.1);
		--danger: #d93025;
		--warn: #b06000;
		--on-accent: #ffffff;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0d0f14;
			--bg-glow: rgba(66, 133, 244, 0.18);
			--surface: #171a21;
			--surface-hover: #1e2330;
			--border: #2a2f3a;
			--text: #eef0f4;
