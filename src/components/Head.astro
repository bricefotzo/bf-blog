---
import Default from '@astrojs/starlight/components/Head.astro';

const { entry } = Astro.locals.starlightRoute;
const linkedinUrl = (entry.data as Record<string, unknown>).linkedinUrl as string | undefined;
---

<Default><slot /></Default>

{linkedinUrl && (
	<meta http-equiv="refresh" content={`0;url=${linkedinUrl}`} />
	<script is:inline define:vars={{ linkedinUrl }}>
		window.location.replace(linkedinUrl);
	</script>
)}
